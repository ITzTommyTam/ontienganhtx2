rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 & Phase 4.1: Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validation Blueprint: LeaderboardBoard
    function isValidLeaderboardBoard(data) {
      return data.keys().hasAll(['ownerId', 'topPilotName', 'topScore', 'entries', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'topPilotName', 'topScore', 'entries', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.topPilotName is string && data.topPilotName.size() >= 1 && data.topPilotName.size() <= 40
        && data.topScore is int && data.topScore >= 0 && data.topScore <= 10000000
        && data.entries is list && data.entries.size() >= 1 && data.entries.size() <= 20
        && data.entries[0] is string && data.entries[0].size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ChallengeRoom
    function isValidChallengeRoom(data) {
      return data.keys().hasAll([
          'ownerId', 'hostName', 'hostScore', 'hostAccuracy',
          'guestId', 'guestName', 'guestScore', 'guestAccuracy',
          'sectionFilter', 'seed', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'hostName', 'hostScore', 'hostAccuracy',
          'guestId', 'guestName', 'guestScore', 'guestAccuracy',
          'sectionFilter', 'seed', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 40
        && data.hostScore is int && data.hostScore >= 0 && data.hostScore <= 10000000
        && data.hostAccuracy is int && data.hostAccuracy >= 0 && data.hostAccuracy <= 100
        && data.guestId is string && data.guestId.size() >= 1 && data.guestId.size() <= 128 && data.guestId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 40
        && data.guestScore is int && data.guestScore >= 0 && data.guestScore <= 10000000
        && data.guestAccuracy is int && data.guestAccuracy >= 0 && data.guestAccuracy <= 100
        && data.sectionFilter is string && data.sectionFilter.size() <= 32
        && data.sectionFilter in ['ALL', 'GETTING_STARTED', 'LANGUAGE', 'READING', 'SPEAKING_LISTENING', 'WRITING_CULTURE', 'LOOKING_BACK']
        && data.seed is int && data.seed >= 0 && data.seed <= 999999999
        && data.status is string && data.status.size() <= 16
        && data.status in ['waiting', 'active', 'completed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: PilotProfile
    function isValidPilotProfile(data) {
      return data.keys().hasAll(['ownerId', 'pilotName', 'bestScore', 'missedWordIds', 'reminderTime', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'pilotName', 'bestScore', 'missedWordIds', 'reminderTime', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.pilotName is string && data.pilotName.size() >= 1 && data.pilotName.size() <= 40
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 10000000
        && data.missedWordIds is list && data.missedWordIds.size() <= 50
        && (data.missedWordIds.size() == 0 || (data.missedWordIds[0] is string && data.missedWordIds[0].size() <= 64))
        && data.reminderTime is string && data.reminderTime.size() == 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection 1: /global_boards/{boardId}
    match /global_boards/{boardId} {
      allow get: if isSignedIn() && isValidId(boardId) && (existing().ownerId == request.auth.uid || existing().topScore >= 0);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(boardId)
        && isValidLeaderboardBoard(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(boardId)
        && isValidLeaderboardBoard(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'topPilotName', 'topScore', 'entries', 'updatedAt']);
      allow delete: if false;
    }

    // Collection 2: /challenges/{roomId}
    match /challenges/{roomId} {
      allow get: if isSignedIn()
        && isValidId(roomId)
        && (existing().ownerId == request.auth.uid || existing().guestId == request.auth.uid || existing().status == 'waiting');
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(roomId)
        && isValidChallengeRoom(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(roomId)
        && isValidChallengeRoom(incoming())
        && existing().status != 'completed'
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Host updates their own score/status
          (existing().ownerId == request.auth.uid
            && incoming().guestId == existing().guestId
            && incoming().diff(existing()).affectedKeys().hasOnly(['hostScore', 'hostAccuracy', 'status', 'updatedAt']))
          ||
          // Action 2: Guest joins a waiting room or updates guest score
          ((existing().status == 'waiting' || existing().guestId == request.auth.uid)
            && incoming().guestId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['guestId', 'guestName', 'guestScore', 'guestAccuracy', 'status', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Collection 3: /pilots/{pilotId}
    match /pilots/{pilotId} {
      allow get: if isSignedIn() && isValidId(pilotId) && request.auth.uid == pilotId && existing().ownerId == request.auth.uid;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(pilotId)
        && request.auth.uid == pilotId
        && isValidPilotProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(pilotId)
        && request.auth.uid == pilotId
        && isValidPilotProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['pilotName', 'bestScore', 'missedWordIds', 'reminderTime', 'updatedAt']);
      allow delete: if false;
    }
  }
}
